# -----------------------------------------------------------------------------
# AM Marketing — backend
# Copie para `.env` no desenvolvimento local. Em produção, preencha no painel do
# Render (Environment). NUNCA commite este arquivo preenchido.
# -----------------------------------------------------------------------------

# --- Slack -------------------------------------------------------------------
# Slack App > OAuth & Permissions > Bot User OAuth Token.
# Comeca com "xoxb-" seguido de tres blocos de numeros e letras.
# Deixe vazio aqui: este arquivo e um modelo e vai para o Git.
SLACK_BOT_TOKEN=
# Slack App > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=

# Slack ID da administradora do Marketing (Suzana Martins Tavares).
ADMIN_SLACK_ID=U09F9LWM6MC

# --- Firebase ----------------------------------------------------------------
# Service account JSON codificado em base64, numa linha só.
#   Linux/macOS: base64 -w0 serviceAccount.json
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Acesso administrativo ---------------------------------------------------
# PIN que a Suzana digita no app. Use 6+ dígitos.
ADMIN_PIN=
# Segredo para assinar o token HMAC das rotas /admin/*.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# --- Rede --------------------------------------------------------------------
# URL do frontend. Restringe o CORS e monta os links "Abrir no app".
# Local: http://localhost:5173
APP_URL=http://localhost:5173

# Porta HTTP. O Render define isso sozinho; localmente vale o padrão 8080.
PORT=8080
