# -----------------------------------------------------------------------------
# AM Marketing — frontend
# Copie para `.env.local` (desenvolvimento) ou preencha no painel do Render.
#
# Tudo que comeca com VITE_ vai para dentro do bundle e e PUBLICO.
# Nunca coloque aqui o token do Slack nem a service account do Firebase.
# -----------------------------------------------------------------------------

# Config web do Firebase: Console > Configuracoes do projeto > Seus apps > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend (Render Web Service). Sem barra no final.
# Local: http://localhost:8080
VITE_API_URL=http://localhost:8080
