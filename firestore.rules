rules_version = '2';

// =============================================================================
// AM Marketing — regras do Firestore (seção 10 da especificação)
//
// Princípio: o app fala direto com o Firestore para LER em tempo real e para
// criar requisições e mensagens. Tudo que decide alguma coisa — `status`,
// `decision`, devolução, catálogo, configurações — só o backend escreve, via
// Admin SDK (que ignora estas regras por ser credencial de servidor).
//
// Limitação conhecida e documentada: a autenticação é ANÔNIMA, então o
// `request.auth.uid` não tem relação com o `slackId` da pessoa. Estas regras
// protegem a INTEGRIDADE dos dados (ninguém aprova a própria requisição, nem
// inventa um status), não a identidade. A evolução sugerida no DECISIONS.md é
// "Sign in with Slack" (OIDC), que permitiria exigir
// `request.auth.uid == requesterId`.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Auxiliares
    // -------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // -------------------------------------------------------------------------
    // Coleções somente-leitura para o cliente (escrita apenas pelo Admin SDK)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /settings/app {
      allow read: if signedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Contador da numeração sequencial (#0042)
    //
    // O cliente incrementa dentro da transação que cria a requisição. Só é
    // permitido somar exatamente 1: assim ninguém pula ou reserva números.
    // -------------------------------------------------------------------------

    match /settings/counters {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['requests'])
                    && request.resource.data.requests == 1;

      allow update: if signedIn()
                    && request.resource.data.keys().hasOnly(['requests'])
                    && request.resource.data.requests is int
                    && request.resource.data.requests == resource.data.requests + 1;

      allow delete: if false;
    }

    // Qualquer outro documento em `settings` fica fora do alcance do cliente.
    match /settings/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Requisições
    // -------------------------------------------------------------------------

    match /requests/{requestId} {

      // Toda pessoa autenticada lê todas as requisições: a agenda e o catálogo
      // mostram quem está com cada item, e a administradora precisa da fila
      // inteira. O que é privado é a CONVERSA, não a reserva.
      allow read: if signedIn();

      // --- Criação -----------------------------------------------------------
      //
      // Nasce sempre `pending`, sem decisão e sem devolução. Os campos que o
      // backend controla (`decision`, `returnedAt`, `returnedOn`, `slack`) não
      // podem vir do cliente.

      function validNewRequest() {
        let data = request.resource.data;

        return data.status == 'pending'
               && data.number is int && data.number > 0

               && isText(data.requesterId, 40)
               && isText(data.requesterName, 120)

               && data.items is list
               && data.items.size() >= 1
               && data.items.size() <= 20

               && isText(data.purposeType, 60)
               && isText(data.purpose, 1000)

               && data.city is map
               && data.city.name is string

               && isDay(data.startDate)
               && isDay(data.endDate)
               && data.startDate <= data.endDate
               && data.days is int && data.days >= 1 && data.days <= 90

               && data.notify.adminPending == true
               && data.unread.admin == 1
               && data.unread.requester == 0

               && data.createdAt == request.time

               // Campos exclusivos do backend não podem chegar na criação.
               && !('decision' in data)
               && !('returnedAt' in data)
               && !('returnedOn' in data)
               && !('cancelledAt' in data)
               // `slack` só é preenchido pelo backend, depois de mandar a DM.
               && (!('slack' in data) || data.slack.keys().size() == 0);
      }

      allow create: if signedIn() && validNewRequest();

      // --- Atualização -------------------------------------------------------
      //
      // Exatamente duas operações são permitidas ao cliente:
      //   1. cancelar a própria requisição enquanto ela está pendente;
      //   2. zerar o contador de não lidas ao abrir o ticket.
      // `status`, `decision`, `returnedAt` e `number` nunca são editáveis daqui.

      function isCancellation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();

        return resource.data.status == 'pending'
               && request.resource.data.status == 'cancelled'
               && changed.hasOnly(['status', 'cancelledAt', 'updatedAt'])
               && request.resource.data.cancelledAt == request.time;
      }

      function isMarkRead() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();

        return changed.hasOnly(['unread'])
               // Só pode DIMINUIR: ninguém infla o contador do outro lado.
               && request.resource.data.unread.admin <= resource.data.unread.admin
               && request.resource.data.unread.requester <= resource.data.unread.requester;
      }

      allow update: if signedIn() && (isCancellation() || isMarkRead());

      allow delete: if false;

      // -----------------------------------------------------------------------
      // Timeline + chat
      //
      // O cliente cria apenas os eventos que ele de fato realiza: a mensagem do
      // chat, o marco de criação e o cancelamento. `approved`, `rejected` e
      // `returned` só existem se vierem do backend — é isso que impede alguém
      // de forjar uma aprovação na linha do tempo.
      // -----------------------------------------------------------------------

      match /events/{eventId} {
        allow read: if signedIn();

        function validNewEvent() {
          let data = request.resource.data;

          return data.type in ['message', 'created', 'cancelled']
                 && isText(data.authorId, 40)
                 && isText(data.authorName, 120)
                 && data.authorRole in ['admin', 'requester']
                 && data.createdAt == request.time
                 && data.notify.pending is bool
                 && (data.type != 'message' || isText(data.text, 2000))
                 && !('meta' in data);
        }

        allow create: if signedIn() && validNewEvent();

        // O histórico é imutável: nem editar, nem apagar.
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Nada mais é acessível.
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
